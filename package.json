{
  "name": "mars-explorer",
  "version": "3.0.0",
  "private": true,
  "description": "Layered Mars map built from real NASA data to plan a safe Marswalk (EVA), with a first-person rehearsal on real terrain.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/orbitron": "5.1.0",
    "@fontsource/rajdhani": "5.1.0",
    "@fontsource/share-tech-mono": "5.1.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "eslint": "9.39.5",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
