# Security headers for static hosts that support this file (Netlify, Cloudflare Pages).
# GitHub Pages ignores it; there the CSP <meta> injected at build time still applies.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.nasa.gov; connect-src 'self' blob: data: https://images-api.nasa.gov https://trek.nasa.gov https://marshub.s3.amazonaws.com https://mars.nasa.gov https://api.nasa.gov; font-src 'self' data:; worker-src 'self' blob:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
